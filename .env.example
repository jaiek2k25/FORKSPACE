# FORKSPACE configuration — copy to .env and fill in locally.
# .env is git-ignored. Values are read by the server only and never sent to the
# browser, logged, or returned in a response.

# --- Server ------------------------------------------------------------------
PORT=5173
NODE_ENV=development
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY=0
# Seconds. Set (e.g. 15552000) only when serving over HTTPS. Adds HSTS.
HSTS_MAX_AGE=0
LOG_LEVEL=info

# --- Research assistant -------------------------------------------------------
# Without a key the app uses the deterministic demo adapter (no network calls).
# The key is read from this file or the environment. It never reaches the client.
NVIDIA_API_KEY=
NVIDIA_MODEL=poolside/laguna-xs-2.1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Geocoding ----------------------------------------------------------------
# nominatim (default, no key) | google (requires a key, billing applies) | none
GEOCODER=nominatim
# Required by the OpenStreetMap Nominatim usage policy: an identifying contact.
# Without it the geocoder proxy stays disabled and answers 503 geocoder_disabled.
GEOCODER_CONTACT=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_MS=1000
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json

# --- Map tiles ----------------------------------------------------------------
# 1 (default) draws maps with Leaflet, which is vendored into assets/vendor/ and
# served from this origin. Set to 0 to serve the map view with its written
# explanation and no external host at all.
MAP_ENABLED=1
# Must be an https:// XYZ template containing {z}, {x} and {y}. The default is the
# exact URL the OpenStreetMap tile usage policy requires, and those tile servers are
# donated capacity with no SLA: point this at a provider you have arranged before you
# carry real traffic. The single origin in this URL is the only remote entry added to
# the Content-Security-Policy, and it is an image source only.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_MAX_ZOOM=19

# --- Licensed data imports ----------------------------------------------------
# Folder read by the licensed-file adapter. It is NOT web-served and is git-ignored.
LICENSED_DATA_DIR=data-imports

# --- Authorised partner feed --------------------------------------------------
# Disabled unless all three of URL, KEY and LICENSEE are set. HTTPS only, redirects
# refused, bearer auth sent from the server. The key never reaches the browser,
# a log line, an error message or this repository.
AUTHORISED_FEED_URL=
AUTHORISED_FEED_KEY=
AUTHORISED_FEED_LICENSEE=
AUTHORISED_FEED_TIMEOUT_MS=15000
